# Local subscription-backed CLI mode. No API keys are used.
INNER_SIGNAL_MODE=cli

# These are executable names unless your binaries live elsewhere.
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude

# New standalone runtime policy: Opus 5 normally, Fable 5 only when escalation is useful.
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_ESCALATION_MODEL=claude-fable-5
# Sonnet handles low-cost extraction/realization on ordinary turns; Opus/Codex are reserved for reviewed/deep tiers.
RESPONSE_RENDERER_MODEL=claude-sonnet-4-6
THERAPY_PROCESSING_MODE=auto

CODEX_REASONING_EFFORT=high
CLAUDE_EFFORT=high

# The user explicitly authorizes Fable usage and has ample credits.
ALLOW_CLAUDE_FABLE_USAGE=true
AUTOPILOT_ESCALATE_TO_FABLE=true
AUTOPILOT_USE_STRUCTURED_RENDERER=true
AUTOPILOT_PRIMARY_HYPNOSIS_ATTEMPTS=1
ADJUDICATOR_PROVIDER=openai

# Ignore personal/project CLI instructions so the therapy pipeline is reproducible.
CLI_ISOLATE_CONFIG=true
REQUEST_TIMEOUT_MS=1200000
ENTITLEMENT_TIMEOUT_MS=300000

# full = sensitive local transcript/evidence; redacted = hashes and selected outcomes; off = none
LEDGER_MODE=full

# Structured hypnosis compiler roles.
HYPNOSIS_WRITER_PROVIDER=anthropic
HYPNOSIS_REVIEWER_PROVIDER=openai
HYPNOSIS_REPAIR_PROVIDER=anthropic
HYPNOSIS_FINAL_REVIEWER_PROVIDER=openai

# Guide Packet roles never use a CLI default or alias. Fable is a separate conditional escalation role.
OPENAI_MODEL_FALLBACKS=gpt-5.6-sol
ANTHROPIC_MODEL_FALLBACKS=claude-opus-5
GUIDE_PACKET_HEARTBEAT_MS=5000
GUIDE_PACKET_STALE_MS=30000
AUTOPILOT_MAX_HYPNOSIS_ATTEMPTS=3
AUTOPILOT_RUN_A001=true
AUTOPILOT_RUN_RUNTIME_SMOKE=true
AUTOPILOT_DIAGNOSE_FAILURES=true
AUTOPILOT_REUSE_CHECKPOINTS=true
AUTOPILOT_STATE_DIR=./.inner-signal-autopilot
GUIDE_PACKET_ROOT=./.inner-signal-autopilot/guide-packets

# Git-native installation, verified updates, privacy-safe failure delivery, and bounded current-progress heartbeats.
# GitHub credentials remain in the official gh credential store and are never copied here.
INNER_SIGNAL_GITHUB_REPOSITORY=u-dont-existDOTcom/innerSignalGraph
INNER_SIGNAL_GIT_STABLE_BRANCH=stable
INNER_SIGNAL_GIT_DIAGNOSTICS_BRANCH=runtime-diagnostics
INNER_SIGNAL_GIT_SOURCE=~/Téléchargements/innerSignalGraph
INNER_SIGNAL_GIT_AUTO_UPDATE=true
# Controls both remote incidents and the bounded current-progress document.
INNER_SIGNAL_GIT_AUTO_DIAGNOSTICS=true

# Continue beyond benchmark readiness into the local web MVP and launch it.
AUTOPILOT_RUN_WEB_SMOKE=true
AUTOPILOT_LAUNCH_APP=true
PORT=8787
# Optional single executable name/path used to open the ready loopback URL.
# Flags, command strings, and shell fragments are not accepted.
# INNER_SIGNAL_BROWSER_EXECUTABLE=brave-browser

# Autonomous local development loop. The worker consumes Needs work / Too slow
# feedback, creates isolated candidates, repairs with Opus (Fable escalation),
# obtains Codex review, runs deterministic gates and exact-case replay, and
# automatically promotes only restorative/non-policy repairs.
DEV_AUTOMATION_ENABLED=true
DEV_AUTO_REPAIR=true
DEV_AUTO_PROMOTE_RESTORATIVE=true
DEV_REPAIR_MODEL=claude-opus-5
DEV_ESCALATION_MODEL=claude-fable-5
DEV_REVIEW_MODEL=gpt-5.6-sol
DEV_REVIEW_TIMEOUT_MS=180000
DEV_REVIEW_EXTENDED_TIMEOUT_MS=600000
DEV_LIVE_REGRESSION_ATTEMPTS=2
DEV_LIVE_REGRESSION_TIMEOUT_MS=900000
DEV_MAX_REPAIR_CYCLES=2
DEV_SUPERVISOR_MAX_RECOVERIES=2
DEV_WORKER_POLL_MS=3000
DEV_SLOW_RESPONSE_MS=180000
