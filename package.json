{
  "name": "inner-signal-runtime",
  "version": "0.15.2",
  "private": true,
  "description": "Inner Signal runtime with verified stable-branch updates, privacy-safe diagnostics and progress, stage-aware recovery, exact-model role enforcement, and owner-gated Guide Packets.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "private-case:mcp": "node src/cli/private-case-mcp.mjs",
    "private-case:mcp:hosted": "node src/cli/private-case-mcp.mjs --hosted-env",
    "private-case:operations": "node src/cli/private-case-operations.mjs",
    "private-case:acceptance": "node --test tests/private-case-continuity.test.mjs tests/private-candidate-lifecycle.test.mjs tests/private-case-operator-cli.test.mjs tests/private-case-orchestration.test.mjs tests/private-therapy-runtime.test.mjs tests/private-runtime-environment.test.mjs tests/private-therapy-model-runtime.test.mjs tests/therapy-ledger-privacy.test.mjs",
    "journal:import": "node src/cli/journal-import.mjs",
    "journal:work:mcp": "node src/cli/journal-work-mcp.mjs",
    "journal:work:codex": "node src/cli/journal-codex-worker.mjs",
    "journal:work:claude": "node src/cli/journal-codex-worker.mjs --agent claude",
    "journal:work": "node src/cli/journal-work.mjs",
    "journal:test": "node --test tests/journal-*.test.mjs",
    "journal:ui:build": "vite build --config apps/journal-web/vite.config.ts",
    "journal:ui:test": "vitest run --config apps/journal-web/vite.config.ts",
    "constitution-context:preflight": "node scripts/constitution-context-preflight.mjs",
    "constitution-context:acceptance": "node scripts/constitution-context-acceptance.mjs",
    "authoring:task:preflight": "node scripts/authoring-task-preflight.mjs",
    "authoring:task:acceptance": "node scripts/authoring-task-acceptance.mjs",
    "authoring:project": "node src/cli/authoring.mjs project",
    "authoring:check": "node src/cli/authoring.mjs check",
    "authoring:validate": "node src/cli/authoring.mjs validate",
    "authoring:proposal:new": "node src/cli/authoring.mjs proposal-new",
    "authoring:proposal:build": "node src/cli/authoring.mjs proposal-build",
    "authoring:proposal:check": "node src/cli/authoring.mjs proposal-check",
    "authoring:proposal:reconcile": "node src/cli/authoring.mjs proposal-reconcile",
    "authoring:maps": "node src/cli/authoring.mjs maps",
    "authoring:maps:check": "node src/cli/authoring.mjs maps-check",
    "test": "node --test",
    "replay": "node src/cli/replay.mjs",
    "replay:cli": "node --env-file=.env src/cli/replay.mjs",
    "respond": "node src/cli/respond.mjs",
    "respond:cli": "node --env-file=.env src/cli/respond.mjs",
    "check:cli": "node --env-file=.env src/cli/check-cli.mjs",
    "check:api": "node --env-file=.env src/cli/check-models.mjs",
    "serve": "node src/cli/serve.mjs",
    "serve:cli": "node --env-file=.env src/cli/serve.mjs",
    "verify": "bash ./scripts/verify-clean.sh",
    "audit:workflows": "node scripts/audit-workflows.mjs",
    "audit:repository": "node scripts/audit-repository.mjs",
    "audit:publication": "node scripts/audit-publication.mjs",
    "audit:publication:hosted": "bash scripts/run-publication-audit-hosted.sh --github u-dont-existDOTcom/innerSignalGraph",
    "therapy-lessons:verify": "node scripts/verify-therapy-lessons.mjs",
    "hypnosis:replay": "node src/cli/hypnosis-replay.mjs",
    "hypnosis:replay:cli": "node --env-file=.env src/cli/hypnosis-replay.mjs",
    "hypnosis:respond": "node src/cli/hypnosis-respond.mjs",
    "hypnosis:respond:cli": "node --env-file=.env src/cli/hypnosis-respond.mjs",
    "diagnose:cli": "node --env-file=.env src/cli/diagnose-cli.mjs",
    "auto:cli": "bash scripts/auto-cli.sh",
    "autopilot": "node --env-file=.env src/cli/autopilot.mjs",
    "web:smoke": "node -e \"import('./src/core/config.mjs').then(async ({loadConfig})=>{const {createProviders}=await import('./src/providers/factory.mjs');const {runWebClientSmoke}=await import('./src/autopilot/web-smoke.mjs');const c=loadConfig({mode:'mock'});console.log(JSON.stringify(await runWebClientSmoke({config:c,providers:createProviders(c)}),null,2));})\"",
    "benchmark:therapy-latency": "node scripts/benchmark-therapy-latency.mjs",
    "verify:local-release": "node scripts/verify-local-release.mjs",
    "graph:compile": "node src/cli/compile-guide-graphs.mjs",
    "graph:test": "node src/cli/run-graph-regressions.mjs",
    "prepare:env": "node src/cli/prepare-environment.mjs",
    "dev:worker": "node --env-file=.env src/cli/dev-worker.mjs --watch",
    "dev:once": "node --env-file=.env src/cli/dev-worker.mjs --once",
    "dev:replay": "node --env-file=.env src/cli/replay-development-case.mjs",
    "guide-packet:build-fixture": "node src/cli/guide-packet.mjs build-r02-fixture",
    "guide-packet:build-r01-fixture": "node src/cli/guide-packet.mjs build-fixture",
    "guide-packet:verify": "node src/cli/guide-packet.mjs verify guide-packets/fixtures/r02-candidate/inner-signal-guide-packet-r02-candidate.zip",
    "guide-packet:verify:r01": "node src/cli/guide-packet.mjs verify guide-packets/fixtures/r01-candidate/inner-signal-guide-packet-r01-candidate.zip",
    "guide-packet:status": "node --env-file=.env src/cli/guide-packet.mjs status",
    "test:role-belief-integrity": "node --test tests/role-belief-memory.test.mjs tests/role-belief-prompts.test.mjs tests/role-belief-trajectories.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jose": "6.2.12",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
