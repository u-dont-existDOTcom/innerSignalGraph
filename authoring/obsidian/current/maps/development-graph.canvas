    {
      "color": "3",
      "height": 140,
      "id": "856accaf7ecba784c3592e624cef18173d559a5cab648e8bedbbb9d4eaa1979b",
      "text": "OWNER-APPROVED, NOT COMPILED\nOVERLAY.IC.UNSAFE_IMPULSE_PAUSE\nPause an immediately unsafe impulse\n\nThe Protector may pause an immediately unsafe impulse and seek support while the underlying feeling remains permitted.",
      "type": "text",
      "width": 300,
      "x": 12600,
      "y": 2200
    },
    {
      "color": "3",
      "height": 140,
      "id": "867b86b265da3f3d53e6940ca5adbe713d361718c4540e419b9d7b4f93a706be",
      "text": "OWNER-APPROVED, NOT COMPILED\nOVERLAY.IC.DYNAMIC_PARTS_MODEL\nUse parts modeling dynamically and only while useful\n\nDo not create parts unless that model is useful. Do not over-separate or over-integrate internal positions because a map depicts them that way. The useful model may change from one moment to the next.",
      "type": "text",
      "width": 300,
      "x": 12600,
      "y": 660
    },
