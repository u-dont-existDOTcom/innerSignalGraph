    {
      "file": "current/nodes/inner-child-directed-graph/IC.BORROW_LOVE.md",
      "height": 140,
      "id": "ea222b0d69ad230aa338a82e6a589e1132108e674d1f3e28103376a281074c80",
      "type": "file",
