{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inner-signal-map-overlay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "mapId", "items"],
  "properties": {
    "contractVersion": { "const": "inner-signal-map-overlay-v1" },
    "mapId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "authority", "title", "description", "sourceRefs", "anchorNodeIds", "relation", "reconciledNodeIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^OVERLAY\\.[A-Z0-9._-]+$" },
          "status": { "enum": ["proposal", "owner-approved-uncompiled", "reconciled", "retired"] },
          "authority": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/nonEmptyStrings" },
          "anchorNodeIds": { "$ref": "#/$defs/nonEmptyStrings" },
          "relation": { "type": "string", "minLength": 1 },
          "reconciledNodeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "reconciled" } }, "required": ["status"] },
            "then": {
              "properties": {
                "reconciledNodeIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" },
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
