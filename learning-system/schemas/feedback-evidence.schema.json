{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innerself.love/schemas/feedback-evidence.schema.json",
  "title": "InnerSignal offline feedback evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "feedbackId", "feedbackClass", "validationStatus", "evidenceClass", "generalizedSignal", "expectedBehavior", "failureReason", "syntheticRegressionExample", "policySurface", "subjectKey", "outcomeDirection", "causalBoundary", "evidenceBasis", "versionContext", "runtimeAuthority", "therapyPolicyAuthority", "transmissionAuthority"],
  "properties": {
    "format": { "const": "inner-signal-feedback-evidence-v1" },
    "feedbackId": { "type": "string", "pattern": "^ISF-SYN-[A-Z0-9-]{3,64}$" },
    "feedbackClass": { "enum": ["style-process-preference", "case-outcome-observation", "factual-correction", "therapy-policy-or-safety-signal", "unsupported-disagreement", "agreement-reassurance-diagnosis-dependency-request", "unresolved"] },
    "validationStatus": { "enum": ["unreviewed", "participant-report", "validated", "ineligible"] },
    "evidenceClass": { "enum": ["self-authenticating-preference", "participant-reported", "independently-verified-fact", "existing-contract-violation", "therapy-policy-signal-unverified", "safety-signal-unverified", "unsupported-disagreement", "ineligible"] },
    "generalizedSignal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "expectedBehavior": { "type": "string", "minLength": 1, "maxLength": 500 },
    "failureReason": { "type": "string", "maxLength": 500 },
    "syntheticRegressionExample": { "type": "string", "minLength": 1, "maxLength": 500 },
    "policySurface": { "enum": ["presentation", "process", "factual", "outcome", "therapy-policy", "safety"] },
    "subjectKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "outcomeDirection": { "enum": ["benefit", "no-change", "mixed", "worsening", "unclear", "not-applicable"] },
    "causalBoundary": { "enum": ["not-applicable", "participant-report-only-no-causal-inference", "independently-verified-fact", "existing-contract-violation", "unresolved"] },
    "evidenceBasis": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "versionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "contractVersion"],
      "properties": {
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "contractVersion": { "const": "offline-groundwork-v1" }
      }
    },
    "runtimeAuthority": { "const": "none" },
    "therapyPolicyAuthority": { "const": "none" },
    "transmissionAuthority": { "const": "none" }
  }
}
