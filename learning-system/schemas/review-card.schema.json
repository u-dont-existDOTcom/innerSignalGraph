{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innerself.love/schemas/review-card.schema.json",
  "title": "InnerSignal synthetic learning review card",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "candidateReceipt", "status", "candidateKind", "evidenceClass", "causalBoundary", "subjectKey", "generalizedObservation", "proposedInvariant", "proposedRegression", "occurrenceCount", "contradictionCounts", "runtimeAuthority", "therapyPolicyAuthority", "availableReviewActions"],
  "properties": {
    "format": { "const": "inner-signal-learning-review-card-v1" },
    "candidateReceipt": { "type": "string", "pattern": "^ISL-MOCK-[a-f0-9]{16}$" },
    "status": { "enum": ["needs-review", "insufficient-evidence", "duplicate", "rejected", "decision-preparation"] },
    "candidateKind": { "enum": ["validated-defect", "participant-outcome", "therapy-policy-signal", "safety-signal", "style-process"] },
    "evidenceClass": { "enum": ["self-authenticating-preference", "participant-reported", "independently-verified-fact", "existing-contract-violation", "therapy-policy-signal-unverified", "safety-signal-unverified", "unsupported-disagreement", "ineligible"] },
    "causalBoundary": { "enum": ["not-applicable", "participant-report-only-no-causal-inference", "independently-verified-fact", "existing-contract-violation", "unresolved"] },
    "subjectKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "generalizedObservation": { "type": "string", "minLength": 1, "maxLength": 500 },
    "proposedInvariant": { "type": "string", "minLength": 1, "maxLength": 500 },
    "proposedRegression": { "type": "string", "minLength": 1, "maxLength": 500 },
    "occurrenceCount": { "type": "integer", "minimum": 0 },
    "contradictionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benefit", "no-change", "mixed", "worsening", "unclear"],
      "properties": {
        "benefit": { "type": "integer", "minimum": 0 },
        "no-change": { "type": "integer", "minimum": 0 },
        "mixed": { "type": "integer", "minimum": 0 },
        "worsening": { "type": "integer", "minimum": 0 },
        "unclear": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeAuthority": { "const": "none" },
    "therapyPolicyAuthority": { "const": "none" },
    "availableReviewActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["reject", "insufficient-evidence", "duplicate", "personalization-process-only", "needs-external-evidence", "prepare-therapy-policy-decision"] }
    }
  }
}
