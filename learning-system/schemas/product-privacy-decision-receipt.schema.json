        "candidateScope": { "const": "privacy-screened-generalized-candidates-only" },
        "paidApiRequiredForApiPath": { "const": true },
        "paidGlobalContributionDisableAvailable": { "const": true },
        "identifiabilityWarningRequired": { "const": true },
        "classification": { "const": "PRODUCT_PRIVACY_ECONOMIC_POLICY" },
        "therapyPolicyAuthority": { "const": "none" }
      }
    },
    "implementationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offlinePolicyDesign", "rawTherapyChatTransmission", "existingCandidateBackfill", "liveTransmission", "realQueue", "billing", "liveSignup", "privacyPolicyPublication", "runtimePersonalization", "therapyPolicyActivation", "release"],
      "properties": {
        "offlinePolicyDesign": { "const": true },
        "rawTherapyChatTransmission": { "const": false },
        "existingCandidateBackfill": { "const": false },
        "liveTransmission": { "const": false },
        "realQueue": { "const": false },
        "billing": { "const": false },
        "liveSignup": { "const": false },
        "privacyPolicyPublication": { "const": false },
        "runtimePersonalization": { "const": false },
        "therapyPolicyActivation": { "const": false },
        "release": { "const": false }
      }
    }
