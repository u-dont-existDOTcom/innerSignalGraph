  "invariants": [
    {
      "id": "J01",
      "rule": "Original bytes survive every derived transformation until authorized deletion.",
      "verification": "round_trip"
    },
    {
      "id": "J02",
      "rule": "Every extracted assertion resolves to exact authorized source spans.",
      "verification": "span_integrity"
    },
    {
      "id": "J03",
      "rule": "Saved bytes, parse coverage, extraction coverage and semantic recall are reported separately.",
      "verification": "coverage"
    },
    {
      "id": "J04",
      "rule": "Imported history does not automatically become current case or therapy-policy state.",
      "verification": "state_isolation"
    },
    {
      "id": "J05",
      "rule": "All source matches are traversable by snapshot-bound pagination.",
      "verification": "pagination"
    },
    {
      "id": "J06",
      "rule": "Subject/case/purpose authorization precedes keys, processing and disclosure.",
      "verification": "authorization"
    },
    {
      "id": "J07",
      "rule": "Corrections and deletion invalidate dependent indexes, projections and server handoffs.",
      "verification": "lineage"
    },
    {
      "id": "J08",
      "rule": "Dream, belief, intention, imagined experience, action and outcome retain their distinctions.",
      "verification": "epistemic_fidelity"
    },
    {
      "id": "J09",
      "rule": "Grant revocation blocks queued results and future disclosure.",
      "verification": "revocation"
    },
    {
      "id": "J10",
      "rule": "Atomic generation commit preserves unrelated current-case writes.",
      "verification": "concurrency"
    },
    {
      "id": "J11",
      "rule": "Raw search still reaches unclassified or unextracted readable source units.",
      "verification": "source_fallback"
    },
    {
      "id": "J12",
      "rule": "A handoff reference is not declared complete without working authorized source retrieval.",
      "verification": "fresh_session"
    }
  ],
  "semantic_target": {
    "status": "provisional_not_measured",
    "important_assertion_recall": 0.95,
    "must_not_miss_query_retrieval": 1.0,
    "not_an_archive_only_blocker": true
  },
  "prohibited_completion_claims": [
