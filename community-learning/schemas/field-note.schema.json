{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innersignal.local/schemas/field-note.schema.json",
  "title": "InnerSignal Commons Field Note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "fieldNoteId",
    "participantId",
    "pseudonymSnapshot",
    "sourcePostId",
    "practiceOrFeature",
    "goal",
    "whatTried",
    "context",
    "priorExperience",
    "outcomes",
    "overallOutcome",
    "downsides",
    "confounders",
    "wouldRepeat",
    "causalConfidence",
    "repeatedObservation",
    "consentGrantId",
    "learningStatus",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "format": { "const": "inner-signal-field-note-v1" },
    "fieldNoteId": { "type": "string", "format": "uuid" },
    "participantId": { "type": "string", "format": "uuid" },
    "pseudonymSnapshot": { "type": "string", "minLength": 2, "maxLength": 40 },
    "sourcePostId": { "type": ["string", "null"], "format": "uuid" },
    "practiceOrFeature": { "type": "string", "minLength": 2, "maxLength": 160 },
    "goal": { "type": "string", "minLength": 2, "maxLength": 500 },
    "whatTried": { "type": "string", "minLength": 2, "maxLength": 4000 },
    "context": { "type": "string", "maxLength": 2000 },
    "priorExperience": { "type": "string", "maxLength": 1000 },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate", "laterSameDay", "nextMorning", "followingTwoToThreeDays", "longerFollowUp"],
      "properties": {
        "immediate": { "type": "string", "maxLength": 2000 },
        "laterSameDay": { "type": "string", "maxLength": 2000 },
        "nextMorning": { "type": "string", "maxLength": 2000 },
        "followingTwoToThreeDays": { "type": "string", "maxLength": 2000 },
        "longerFollowUp": { "type": "string", "maxLength": 2000 }
      }
    },
    "overallOutcome": { "enum": ["benefit", "no-change", "mixed", "worsening", "unclear"] },
    "downsides": { "type": "string", "maxLength": 2000 },
    "confounders": { "type": "string", "maxLength": 2000 },
    "wouldRepeat": { "enum": ["yes", "no", "unsure"] },
    "causalConfidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "repeatedObservation": { "type": "boolean" },
    "consentGrantId": { "type": "string", "format": "uuid" },
    "learningStatus": { "enum": ["private-draft", "community-aggregate", "product-improvement", "withdrawn"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
