# Local-only defaults
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=8790
COMMUNITY_DATA_ROOT=./.inner-signal-autopilot/community-learning
COMMUNITY_SESSION_DAYS=30
MAIN_APP_URL=http://localhost:8787

# Required whenever COMMUNITY_HOST is not loopback.
COMMUNITY_INVITE_CODE=replace-with-a-long-random-code
COMMUNITY_MODERATOR_KEY=replace-with-another-long-random-code
