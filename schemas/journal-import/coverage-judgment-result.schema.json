{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "covered": {
            "type": "boolean"
          },
          "missing": {
            "type": "string",
            "maxLength": 300
          },
          "critical_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "maxItems": 200,
            "uniqueItems": true
          },
          "event_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "maxItems": 200,
            "uniqueItems": true
          },
          "repeated_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "maxItems": 200,
            "uniqueItems": true
          },
          "combined_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "maxItems": 200,
            "uniqueItems": true
          },
          "copied_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "maxItems": 200,
            "uniqueItems": true
          }
        },
        "required": [
          "unit_id",
          "covered",
          "missing",
          "critical_question_ids",
          "event_question_ids",
          "repeated_question_ids",
          "combined_question_ids",
          "copied_question_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "judgments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:innersignal:journal:coverage-judgment:1.0"
}
