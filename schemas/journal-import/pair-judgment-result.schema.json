{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pair_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "mentions": {
            "type": "boolean"
          },
          "kind_right": {
            "type": "boolean"
          }
        },
        "required": [
          "pair_id",
          "mentions",
          "kind_right"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "judgments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:innersignal:journal:pair-judgment:1.0"
}
