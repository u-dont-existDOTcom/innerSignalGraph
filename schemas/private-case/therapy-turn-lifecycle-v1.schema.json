{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inner-signal.local/schemas/private-case/therapy-turn-lifecycle-v1.schema.json",
  "title": "Automatic private therapy turn lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "exchange_id", "user_turn_id", "assistant_turn_id", "inbound", "state", "repair_cycle", "current_candidate_id", "discriminator", "delivery", "created_at", "updated_at", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "exchange_id": { "$ref": "#/$defs/id" },
    "user_turn_id": { "$ref": "#/$defs/id" },
    "assistant_turn_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "inbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "sha256", "received_at"],
      "properties": {
        "exact_text": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "received_at": { "type": "string", "format": "date-time" }
      }
    },
    "state": { "$ref": "#/$defs/state" },
    "repair_cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "current_candidate_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "discriminator": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_text", "sha256", "producer_context_id", "created_at"],
          "properties": {
            "exact_text": { "type": "string", "minLength": 2, "maxLength": 1000, "pattern": "^[^\\r\\n]*\\?$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "producer_context_id": { "$ref": "#/$defs/id" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "delivery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assistant_turn_id", "exact_text", "sha256", "delivered_at"],
          "properties": {
            "kind": { "enum": ["candidate", "discriminator"] },
            "assistant_turn_id": { "$ref": "#/$defs/id" },
            "exact_text": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "delivered_at": { "type": "string", "format": "date-time" },
            "candidate_id": { "$ref": "#/$defs/id" },
            "candidate_version": { "type": "integer", "minimum": 1 },
            "audit_id": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/stateEvent" },
          { "$ref": "#/$defs/invocationEvent" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,200}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "enum": ["RECEIVED", "CANDIDATE_PENDING_AUDIT", "AUDITING", "APPROVED", "DELIVERED", "REPAIR_REQUIRED", "RECONSTRUCTING", "DISCRIMINATING_QUESTION_REQUIRED"] },
    "stateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "event_type", "from_state", "to_state", "at", "details"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": { "const": "STATE_TRANSITION" },
        "from_state": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "to_state": { "$ref": "#/$defs/state" },
        "at": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    },
    "invocationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "event_type", "state", "stage", "context_id", "attempt", "input_sha256", "at", "details"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": { "enum": ["INVOCATION_STARTED", "INVOCATION_COMPLETED", "INVOCATION_FAILED", "INVOCATION_ABANDONED"] },
        "state": { "$ref": "#/$defs/state" },
        "stage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "context_id": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "at": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    }
  }
}
