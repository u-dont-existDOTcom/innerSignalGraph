{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inner-signal.local/schemas/private-case/candidate-audit-v1.schema.json",
  "title": "Exact-version-bound private candidate audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "candidate_id", "candidate_version", "candidate_sha256", "audit_version", "completed_at", "auditor_kind", "auditor_context_id", "independent_auditor_available", "independent", "findings", "unresolved_substantive_finding_ids", "verdict", "sufficient_for_approval", "repair_induced_checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "candidate_version": { "type": "integer", "minimum": 1 },
    "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "audit_version": { "$ref": "#/$defs/id" },
    "completed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "completed_at_status": { "enum": ["known", "unavailable"] },
    "recorded_at": { "type": "string", "format": "date-time" },
    "auditor_kind": { "enum": ["independent", "self_critique"] },
    "auditor_context_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "auditor_context_id_status": { "enum": ["known", "unavailable"] },
    "independent_auditor_available": { "type": "boolean" },
    "independent": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "severity", "summary", "unresolved"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "code": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["low", "medium", "substantive", "high"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "unresolved": { "type": "boolean" },
          "evidence_turn_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }
      }
    },
    "unresolved_substantive_finding_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "verdict": { "enum": ["pass", "fail"] },
    "sufficient_for_approval": { "type": "boolean" },
    "repair_induced_checks": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "response_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "policy_version": {
          "const": "response-evidence-v1"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "auditor_inclusion_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dimension": {
                    "enum": [
                      "prior_delivery",
                      "personal_history",
                      "history_dependent_advice",
                      "source_consultation_claims",
                      "coverage_scope_and_conflicts"
                    ]
                  },
                  "status": {
                    "enum": [
                      "assessed",
                      "no_applicable_items"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "dimension",
                  "status",
                  "reason"
                ]
              },
              "minItems": 5,
              "maxItems": 5
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "dimension": {
                    "enum": [
                      "prior_delivery",
                      "personal_history",
                      "history_dependent_advice",
                      "source_consultation_claims",
                      "coverage_scope_and_conflicts"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "claim",
                      "recommendation",
                      "question_presupposition"
                    ]
                  },
                  "candidate_quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "quote_occurrence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 340
                    },
                    "minItems": 0,
                    "maxItems": 200
                  },
                  "assessment": {
                    "enum": [
                      "supported",
                      "contradicted",
                      "unsupported",
                      "uncertain_but_worded_accurately"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "candidate_span": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "start_utf8_byte": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end_utf8_byte": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "span_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "start_utf8_byte",
                      "end_utf8_byte",
                      "span_sha256"
                    ]
                  },
                  "source_incompatible": {
                    "const": true
                  }
                },
                "required": [
                  "id",
                  "dimension",
                  "kind",
                  "candidate_quote",
                  "quote_occurrence",
                  "source_ids",
                  "assessment",
                  "reason",
                  "candidate_span"
                ]
              },
              "minItems": 0,
              "maxItems": 200
            },
            "missing_material_history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "why_material": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "candidate_quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "quote_occurrence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "candidate_span": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "start_utf8_byte": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end_utf8_byte": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "span_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "start_utf8_byte",
                      "end_utf8_byte",
                      "span_sha256"
                    ]
                  }
                },
                "required": [
                  "id",
                  "question",
                  "why_material",
                  "candidate_quote",
                  "quote_occurrence",
                  "candidate_span"
                ]
              },
              "minItems": 0,
              "maxItems": 200
            }
          },
          "required": [
            "coverage",
            "items",
            "missing_material_history"
          ]
        },
        "derived_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "snapshot_id",
        "snapshot_sha256",
        "auditor_inclusion_sha256",
        "review",
        "derived_finding_ids"
      ]
    },
    "external_provenance": { "$ref": "#/$defs/externalProvenance" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,200}$" },
    "externalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "supplied_by", "received_at", "reported_independence_from_producer_context_id"],
      "properties": {
        "kind": { "const": "externally_supplied_fresh_independent_audit" },
        "supplied_by": { "const": "owner" },
        "received_at": { "type": "string", "format": "date-time" },
        "reported_independence_from_producer_context_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
