{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inner-signal.local/schemas/private-case/operation-request-v1.schema.json",
  "title": "Backend-only private case mutation operation",
  "oneOf": [
    { "$ref": "#/$defs/appendCompletion" },
    { "$ref": "#/$defs/recordAudit" },
    { "$ref": "#/$defs/reconstructAndHandoff" },
    { "$ref": "#/$defs/createHandoff" },
    { "$ref": "#/$defs/approve" },
    { "$ref": "#/$defs/deliverAndHandoff" },
    { "$ref": "#/$defs/markSent" },
    { "$ref": "#/$defs/probeJournalWrite" },
    { "$ref": "#/$defs/createJournalCorpus" },
    { "$ref": "#/$defs/commitJournalGeneration" },
    { "$ref": "#/$defs/rollbackJournalGeneration" },
    { "$ref": "#/$defs/incrementJournalVisibility" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,200}$" },
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
    "journalPurpose": { "enum": ["archive", "organize_search", "session_use", "correct", "review", "export", "delete"] },
    "base": {
      "type": "object",
      "required": ["schema_version", "operation", "case_id"],
      "properties": { "schema_version": { "const": 1 }, "operation": { "type": "string" }, "case_id": { "$ref": "#/$defs/caseId" } }
    },
    "appendCompletion": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "amendment_id", "target_turn_id", "completion_text", "source_artifact_id", "producer_context_id"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "append_transcript_completion" }, "case_id": { "$ref": "#/$defs/caseId" },
          "amendment_id": { "$ref": "#/$defs/id" }, "target_turn_id": { "$ref": "#/$defs/id" }, "completion_text": { "type": "string", "minLength": 1, "maxLength": 80000 },
          "source_artifact_id": { "$ref": "#/$defs/id" }, "producer_context_id": { "$ref": "#/$defs/id" }, "source_metadata": { "type": "object" }
        }
      }]
    },
    "recordAudit": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "candidate_id", "audit_id", "auditor_context", "completed_at", "result"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "record_candidate_audit" }, "case_id": { "$ref": "#/$defs/caseId" }, "candidate_id": { "$ref": "#/$defs/id" }, "audit_id": { "$ref": "#/$defs/id" },
          "auditor_context": { "type": "object", "additionalProperties": false, "required": ["kind", "context_id"], "properties": { "kind": { "enum": ["independent", "self_critique"] }, "context_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "context_id_status": { "enum": ["known", "unavailable"] } } },
          "completed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }, "completed_at_status": { "enum": ["known", "unavailable"] }, "recorded_at": { "type": "string", "format": "date-time" }, "independent_auditor_available": { "type": "boolean" },
          "external_provenance": { "$ref": "#/$defs/externalProvenance" },
          "result": { "type": "object", "required": ["findings"], "properties": { "findings": { "type": "array" }, "repair_induced_checks": { "type": "array", "items": { "type": "string" } } } }
        }
      }]
    },
    "reconstructAndHandoff": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "parent_candidate_id", "candidate_id", "exact_text", "producer_context_id", "based_on_audit_id", "handoff_id", "runtime_version", "audit_version"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "reconstruct_candidate_and_create_handoff" }, "case_id": { "$ref": "#/$defs/caseId" },
          "parent_candidate_id": { "$ref": "#/$defs/id" }, "candidate_id": { "$ref": "#/$defs/id" }, "exact_text": { "type": "string", "minLength": 1 }, "producer_context_id": { "$ref": "#/$defs/id" },
          "based_on_audit_id": { "$ref": "#/$defs/id" }, "handoff_id": { "$ref": "#/$defs/id" }, "runtime_version": { "type": "string", "minLength": 1, "maxLength": 160 }, "audit_version": { "type": "string", "minLength": 1, "maxLength": 160 }, "metadata": { "type": "object" }
        }
      }]
    },
    "createHandoff": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "handoff_id", "runtime_version", "audit_version"],
        "properties": { "schema_version": { "const": 1 }, "operation": { "const": "create_handoff" }, "case_id": { "$ref": "#/$defs/caseId" }, "handoff_id": { "$ref": "#/$defs/id" }, "runtime_version": { "type": "string", "minLength": 1, "maxLength": 160 }, "audit_version": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }]
    },
    "approve": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "candidate_id", "audit_id"],
        "properties": { "schema_version": { "const": 1 }, "operation": { "const": "approve_candidate_for_delivery" }, "case_id": { "$ref": "#/$defs/caseId" }, "candidate_id": { "$ref": "#/$defs/id" }, "audit_id": { "$ref": "#/$defs/id" } }
      }]
    },
    "externalProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "supplied_by", "received_at", "reported_independence_from_producer_context_id"],
      "properties": {
        "kind": { "const": "externally_supplied_fresh_independent_audit" },
        "supplied_by": { "const": "owner" },
        "received_at": { "type": "string", "format": "date-time" },
        "reported_independence_from_producer_context_id": { "$ref": "#/$defs/id" }
      }
    },
    "probeJournalWrite": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "purpose"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "probe_journal_write" }, "case_id": { "$ref": "#/$defs/caseId" },
          "purpose": { "$ref": "#/$defs/journalPurpose" }
        }
      }]
    },
    "createJournalCorpus": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "corpus_id", "manifest_object_id"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "create_journal_corpus" }, "case_id": { "$ref": "#/$defs/caseId" },
          "corpus_id": { "$ref": "#/$defs/id" }, "manifest_object_id": { "$ref": "#/$defs/id" }
        }
      }]
    },
    "commitJournalGeneration": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "corpus_id", "generation", "manifest_object_id", "permitted_uses"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "commit_journal_generation" }, "case_id": { "$ref": "#/$defs/caseId" },
          "corpus_id": { "$ref": "#/$defs/id" }, "generation": { "$ref": "#/$defs/id" }, "manifest_object_id": { "$ref": "#/$defs/id" },
          "expected_generation": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "expected_case_revision": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "permitted_uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["archive", "organize_search", "session_use"] } }
        }
      }]
    },
    "rollbackJournalGeneration": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "corpus_id", "target_generation", "expected_generation"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "rollback_journal_generation" }, "case_id": { "$ref": "#/$defs/caseId" },
          "corpus_id": { "$ref": "#/$defs/id" }, "target_generation": { "$ref": "#/$defs/id" }, "expected_generation": { "$ref": "#/$defs/id" }
        }
      }]
    },
    "incrementJournalVisibility": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "corpus_id", "expected_epoch"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "increment_journal_visibility" }, "case_id": { "$ref": "#/$defs/caseId" },
          "corpus_id": { "$ref": "#/$defs/id" }, "expected_epoch": { "type": "integer", "minimum": 0 }
        }
      }]
    },
    "markSent": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "candidate_id"],
        "properties": { "schema_version": { "const": 1 }, "operation": { "const": "mark_candidate_sent" }, "case_id": { "$ref": "#/$defs/caseId" }, "candidate_id": { "$ref": "#/$defs/id" } }
      }]
    },
    "deliverAndHandoff": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "operation", "case_id", "candidate_id", "audit_id", "assistant_turn_id", "in_reply_to_turn_id", "handoff_id", "runtime_version", "audit_version"],
        "properties": {
          "schema_version": { "const": 1 }, "operation": { "const": "deliver_candidate_and_create_handoff" }, "case_id": { "$ref": "#/$defs/caseId" },
          "candidate_id": { "$ref": "#/$defs/id" }, "audit_id": { "$ref": "#/$defs/id" }, "assistant_turn_id": { "$ref": "#/$defs/id" }, "in_reply_to_turn_id": { "$ref": "#/$defs/id" },
          "handoff_id": { "$ref": "#/$defs/id" }, "runtime_version": { "type": "string", "minLength": 1, "maxLength": 160 }, "audit_version": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }]
    }
  }
}
