{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inner-signal.local/schemas/private-case/supervisor-artifact-v1.schema.json",
  "title": "Private supervisor artifact entry",
  "description": "One append-only entry in a private case's supervisor_artifacts: a supplied input, the supervisor-only companion of one exact candidate version, or the receipt of one independent review. An entry never audits, never approves and never marks anything sent; the draft itself is an ordinary candidate version whose metadata.supervisor_draft is described under $defs/draftMetadata. Runtime validators additionally enforce that a companion and a receipt name stored candidate versions, that every text binds its digest, and that ids are unique.",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/companion" },
    { "$ref": "#/$defs/reviewReceipt" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,160}$" },
    "refId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 80 },
    "operationKey": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$" },
    "suppliedBy": {
      "description": "What the channel proves about who supplied a value. The owner's own app is a verified path; an authenticated agent is not, whatever it claims.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "actor_resolution"],
          "properties": { "channel": { "const": "owner_ui" }, "actor_resolution": { "const": "owner_verified" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["channel", "actor_resolution"],
          "properties": { "channel": { "const": "authenticated_agent" }, "actor_resolution": { "const": "unresolved" } }
        }
      ]
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "kind", "input_type", "author_claim", "text", "text_sha256", "supplied_by", "recorded_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "input" },
        "input_type": { "enum": ["client_message", "supervisor_revision"] },
        "author_claim": { "enum": ["client", "supervisor"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 40000, "pattern": "\\S" },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "supplied_by": { "$ref": "#/$defs/suppliedBy" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      },
      "oneOf": [
        { "type": "object", "properties": { "input_type": { "const": "client_message" }, "author_claim": { "const": "client" } } },
        { "type": "object", "properties": { "input_type": { "const": "supervisor_revision" }, "author_claim": { "const": "supervisor" } } }
      ]
    },
    "companion": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "kind", "companion_of", "language", "text", "text_sha256", "supplied_by", "audience", "client_send_allowed", "meaning_review", "recorded_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "companion" },
        "companion_of": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_id", "candidate_version", "candidate_sha256"],
          "properties": {
            "candidate_id": { "$ref": "#/$defs/refId" },
            "candidate_version": { "type": "integer", "minimum": 1 },
            "candidate_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "language": { "$ref": "#/$defs/language" },
        "text": { "type": "string", "minLength": 1, "maxLength": 100000, "pattern": "\\S" },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "supplied_by": { "$ref": "#/$defs/suppliedBy" },
        "audience": { "const": "supervisor" },
        "client_send_allowed": { "const": false },
        "meaning_review": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unreviewed" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "reviewReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "kind", "candidate_id", "candidate_version", "audit_id", "disclosure_manifest", "provider_receipt", "recorded_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "review_receipt" },
        "candidate_id": { "$ref": "#/$defs/refId" },
        "candidate_version": { "type": "integer", "minimum": 1 },
        "audit_id": { "$ref": "#/$defs/refId" },
        "disclosure_manifest": {
          "description": "What the independent audit run reported it was shown. Booleans only: no text and no content.",
          "type": "object", "maxProperties": 24,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "additionalProperties": { "type": "boolean" }
        },
        "provider_receipt": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["provider", "model", "response_id"],
              "properties": {
                "provider": { "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
                "model": { "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
                "response_id": { "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] }
              }
            }
          ]
        },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "basis": {
      "description": "What the case looked like when the draft was written. A draft whose basis no longer matches the case is stale and is never exported.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "latest_user_turn_id", "transcript_turn_count", "amendments_sha256", "compatibility_state_binding", "communication_history_sha256", "supervisor_inputs_sha256"],
      "properties": {
        "schema_version": { "const": 1 },
        "latest_user_turn_id": { "oneOf": [{ "$ref": "#/$defs/refId" }, { "type": "null" }] },
        "transcript_turn_count": { "type": "integer", "minimum": 0 },
        "amendments_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_state_binding": { "$ref": "#/$defs/sha256" },
        "communication_history_sha256": { "$ref": "#/$defs/sha256" },
        "supervisor_inputs_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "exposure": {
      "description": "How the exact bytes came to be stored, and what is known about who wrote them. Bytes the host or a person supplied carry no attestation of their original writer; bytes the backend wrote carry the existing inclusion receipts.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["exact_bytes", "original_writer", "auditor_inputs"],
          "properties": { "exact_bytes": { "const": "received_and_stored" }, "original_writer": { "const": "not_attested" }, "auditor_inputs": { "const": "case_record_only" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["exact_bytes", "original_writer", "auditor_inputs"],
          "properties": { "exact_bytes": { "enum": ["produced_by_backend", "produced_by_backend_repair"] }, "original_writer": { "const": "backend_inclusion_receipts" }, "auditor_inputs": { "const": "case_record_only" } }
        }
      ]
    },
    "draftMetadata": {
      "description": "The value of metadata.supervisor_draft on a candidate version the supervisor path created. A reserved key: no ordinary candidate write can set it.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source", "root_source", "operation_key", "text_sha256", "basis", "basis_sha256", "exposure"],
      "properties": {
        "schema_version": { "const": 1 },
        "source": { "enum": ["external_draft", "backend_produced", "backend_repair"] },
        "root_source": { "enum": ["external_draft", "backend_produced"] },
        "operation_key": { "$ref": "#/$defs/operationKey" },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "basis": { "$ref": "#/$defs/basis" },
        "basis_sha256": { "$ref": "#/$defs/sha256" },
        "exposure": { "$ref": "#/$defs/exposure" }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": { "const": "external_draft" },
            "root_source": { "const": "external_draft" },
            "exposure": { "type": "object", "properties": { "exact_bytes": { "const": "received_and_stored" } } }
          }
        },
        {
          "type": "object",
          "properties": {
            "source": { "const": "backend_produced" },
            "root_source": { "const": "backend_produced" },
            "exposure": { "type": "object", "properties": { "exact_bytes": { "const": "produced_by_backend" } } }
          }
        },
        {
          "type": "object",
          "properties": {
            "source": { "const": "backend_repair" },
            "exposure": { "type": "object", "properties": { "exact_bytes": { "const": "produced_by_backend_repair" } } }
          }
        }
      ]
    }
  }
}
