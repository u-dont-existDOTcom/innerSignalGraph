# Optional API transport. Not needed for local CLI-subscription testing.
INNER_SIGNAL_MODE=api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
RESPONSE_RENDERER_MODEL=claude-fable-5
ADJUDICATOR_PROVIDER=openai
ALLOW_DEGRADED=false
ACKNOWLEDGE_PROVIDER_RETENTION=false
LEDGER_MODE=redacted
LEDGER_DIR=./ledgers
REQUEST_TIMEOUT_MS=900000
MAX_OUTPUT_TOKENS=12000
GUIDE_EXCERPT_MAX_CHARS=18000
PORT=8787
# Optional single executable name/path used to open the ready loopback URL.
# INNER_SIGNAL_BROWSER_EXECUTABLE=brave-browser
HYPNOSIS_WRITER_PROVIDER=anthropic
HYPNOSIS_REVIEWER_PROVIDER=openai
HYPNOSIS_REPAIR_PROVIDER=anthropic
HYPNOSIS_FINAL_REVIEWER_PROVIDER=openai
