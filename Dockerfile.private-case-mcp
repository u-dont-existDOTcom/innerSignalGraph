FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553

ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src
# The served therapy protocol (load_therapy_protocol) is read from the packaged skill.
COPY plugins/inner-signal-therapy ./plugins/inner-signal-therapy
# The journal import contracts are read at runtime.
COPY schemas ./schemas
# The reply-draft review (INNER_SIGNAL_MCP_SUPERVISOR_DRAFTS) runs the same therapy model runtime as the rest of InnerSignal,
# and that runtime reads the guide texts, the compiled guide graph and the romance-guide source files from disk. They are only
# read when the setting is on and a model is configured; they are packaged so that turning the setting on cannot fail at start.
COPY guides ./guides
COPY guide-graphs/compiled ./guide-graphs/compiled
COPY tasks/romance-guide-20260907 ./tasks/romance-guide-20260907

USER node
EXPOSE 8787
CMD ["npm", "run", "private-case:mcp:hosted"]
