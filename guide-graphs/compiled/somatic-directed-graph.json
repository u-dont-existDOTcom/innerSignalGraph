      "title": "Safety, orientation, and stopping capacity",
      "kind": "decision-node",
      "tier": 1,
      "priority": 100,
      "activation": {
        "any": [
          {
            "field": "present_safety",
            "op": "eq",
            "value": "unsafe"
          },
          {
            "field": "orientation",
            "op": "eq",
            "value": "disoriented"
          },
          {
            "field": "ability_to_stop",
            "op": "eq",
            "value": "no"
          },
          {
            "field": "ability_to_return",
            "op": "eq",
            "value": "no"
